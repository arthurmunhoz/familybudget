# Copy to .env.local (gitignored) and fill in.
#
# ⚠️ .env.local IS GITIGNORED, SO EAS CLOUD BUILDS NEVER SEE IT. An EAS build
# uploads only git-tracked files, so an `EXPO_PUBLIC_*` var that lives only here
# inlines as `undefined` and the feature ships DARK — no build error, no warning.
# (This is exactly how the Android build shipped with a blank Whereabouts map:
# EXPO_PUBLIC_MAPBOX_TOKEN was in .env.local and nowhere else.)
#
# So every var below that a real build needs must ALSO exist as an EAS env var:
#   npx eas env:list --environment preview          # what the builder will see
#   npx eas env:create --name X --value Y \
#     --environment production --environment preview --environment development \
#     --visibility plaintext --scope project
#
# Visibility: use `plaintext` for EXPO_PUBLIC_* — they are compiled into the JS
# bundle and are readable by anyone with the APK, so marking them `secret` buys no
# security and only makes them unverifiable later. Use `secret` for build-time
# credentials that never reach the client (RNMAPBOX_DOWNLOAD_TOKEN).
#
# There is NO expo-updates in this project, so an env-var change cannot be pushed
# over the air — it needs a full rebuild.

# --- Client runtime (inlined into the bundle; also needed as EAS env vars) ---
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# The publishable Supabase key — safe in a client.
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
EXPO_PUBLIC_API_BASE=https://one-roof-app.vercel.app
# Mapbox PUBLIC token (pk.…) — the Whereabouts map + Directions ETAs. Without it
# the screen falls back to the roster and shows "Map needs a Mapbox token".
EXPO_PUBLIC_MAPBOX_TOKEN=pk.your-public-mapbox-token
# RevenueCat publishable SDK keys — ONE PER STORE; the iOS key does not work on
# Android. Unset simply means "no paywall, behaves as free" (see lib/purchases.ts).
EXPO_PUBLIC_REVENUECAT_IOS_KEY=appl_your-ios-key
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=goog_your-android-key

# --- Build-time only (never reaches the client; keep visibility `secret`) ---
# Mapbox SECRET download token (sk.…), used only to fetch the native Maps SDK at
# build time. Already set on EAS for all three environments.
RNMAPBOX_DOWNLOAD_TOKEN=sk.your-secret-download-token

# --- Dev only (the DEV-gated email/password sign-in button on Login) ---
EXPO_PUBLIC_DEV_EMAIL=dev@example.com
EXPO_PUBLIC_DEV_PASSWORD=your-dev-password
